// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id         String   @id @default(cuid())
  titre      String?
  prenom     String?
  nom        String
  email      String?  @unique
  telephone  String?
  secteur    String?
  ville      String?
  departement String?
  pays       String?
  sourceAcquisition String?
  statut     String?
  linkedin   String?
  entreprises EntrepriseContact[]
  activities Activity[]
  actionItems ActionItem[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Entreprise {
  id          String   @id @default(cuid())
  nom         String   @unique
  email       String?
  telephone   String?
  siteWeb     String?
  secteur     String?
  adresse     String?
  ville       String?
  departement String?
  pays        String?
  contacts    EntrepriseContact[]
  activities  Activity[]
  actionItems ActionItem[]
  projects    Project[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EntrepriseContact {
  entrepriseId String
  contactId    String
  poste        String?
  createdAt    DateTime @default(now())
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  contact      Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([entrepriseId, contactId])
  @@index([contactId])
}

model LookupOption {
  id        String   @id @default(cuid())
  category  String
  label     String
  value     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, value])
  @@index([category, active, sortOrder])
}

model Project {
  id          String   @id @default(cuid())
  entrepriseId String?
  nom         String
  pays        String?
  ville       String?
  statut      String   @default("En cours")
  budget      String?
  progression Int      @default(0)
  entreprise  Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entrepriseId])
}

model Activity {
  id             String    @id @default(cuid())
  titre          String
  type           String
  contactLabel   String?   @map("contact")
  contactId      String?
  entrepriseId   String?
  date           DateTime?
  details        String?
  contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  entreprise     Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([contactId])
  @@index([entrepriseId])
}

model ActionItem {
  id             String    @id @default(cuid())
  titre          String
  priorite       String    @default("Normale")
  statut         String    @default("À faire")
  contactLabel   String?   @map("contact")
  contactId      String?
  entrepriseId   String?
  dateEcheance   DateTime?
  details        String?
  contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  entreprise     Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([contactId])
  @@index([entrepriseId])
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  passwordHash    String
  twoFactorSecret String
  role            String    @default("member")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actorUsername String
  action        String
  entity        String
  entityId      String?
  details       String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
