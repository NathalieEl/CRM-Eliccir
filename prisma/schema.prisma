// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContactNoteNature {
  Telephonique
  Email
  WhatsApps
  Presentiel
  Autre
}

enum PropertyType {
  PROJECT
  VILLA
  HOUSE
  APARTMENT
  LAND
  COMMERCIAL
  BUILDING
  WAREHOUSE
  GUESTHOUSE_HOTEL
}

enum PropertyStatus {
  AVAILABLE
  UNDER_OFFER
  SOLD
  RENTED
  WITHDRAWN
}

enum PropertyCondition {
  NEW
  GOOD
  TO_RENOVATE
  OFF_PLAN
}

enum Furnishing {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum WaterSource {
  PDAM
  WELL
  BOTH
  NONE
}

enum TransactionType {
  SALE
  SHORT_TERM_RENTAL
  LONG_TERM_RENTAL
  PURCHASE_SEARCH
}

enum MandateType {
  EXCLUSIVE
  SIMPLE
  CO_AGENCY
}

enum PriceUnit {
  TOTAL
  PER_SQM
  PER_ARE
  PER_MONTH
  PER_YEAR
}

enum PayerParty {
  BUYER
  SELLER
  SPLIT
  TO_BE_DETERMINED
}

enum DealStage {
  PROSPECT
  MANDATE_SIGNED
  LISTED
  OFFER_RECEIVED
  PRELIMINARY_AGREEMENT
  CLOSED
  LOST
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
}

enum FinancingType {
  CASH
  MORTGAGE
  MIXED
}

enum LandRightType {
  HAK_MILIK
  HGB
  HAK_PAKAI
  HAK_SEWA
  HMSRS
  GIRIK
  UNKNOWN
}

enum HoldingStructure {
  INDIVIDUAL
  LOCAL_COMPANY
  PT_PMA
}

enum BuildingPermitStatus {
  PBG_OBTAINED
  SLF_OBTAINED
  LEGACY_IMB
  NONE
  UNKNOWN
}

enum ZoningType {
  RESIDENTIAL
  TOURISM
  COMMERCIAL
  MIXED
  AGRICULTURAL_PROTECTED
  UNKNOWN
}

enum CostType {
  PBB
  BPHTB
  SELLER_TAX
  PPN
  NOTARY_PPAT_FEE
  AGENCY_COMMISSION
  OTHER
}

enum ResidencyStatus {
  CITIZEN
  KITAS
  KITAP
  TOURIST
  OTHER
}

enum DocumentType {
  LAND_CERTIFICATE
  PBG
  SLF
  PBB_RECEIPT
  MANDATE
  PPJB
  AJB
  LEASE_AGREEMENT
  OTHER
}

model Contact {
  id         String   @id @default(cuid())
  titre      String?
  prenom     String?
  deuxiemePrenom String?
  nom        String
  email      String?  @unique
  typeEmail  String?
  libelleEmail String?
  telephone  String?
  typeTelephone String?
  libelleTelephone String?
  surnom     String?
  dateNaissance DateTime? @db.Date
  genre      String?
  biographie String? @db.Text
  metier     String?
  languePreferee String?
  trancheAge String?
  photoProfil Bytes? @db.ByteA
  photoProfilType String?
  secteur    String?
  ville      String?
  departement String?
  pays       String?
  sourceAcquisition String?
  statut     String?
  typeInvestisseur String?
  profilContact String?
  niveauInvestissement String?
  linkedin   String?
  surnoms ContactNickname[]
  emails ContactEmail[]
  telephones ContactPhone[]
  adresses ContactAddress[]
  evenements ContactEvent[]
  relations ContactRelation[] @relation("ContactRelationsOwner")
  relationsRecues ContactRelation[] @relation("ContactRelationsTarget")
  urls ContactUrl[]
  messageries ContactImClient[]
  groupes ContactGroupMembership[]
  champsPersonnalises ContactUserDefined[]
  centresInteret ContactInterest[]
  competences ContactSkill[]
  entreprises EntrepriseContact[]
  projets ContactProject[]
  notes ContactNote[]
  activities Activity[]
  actionItems ActionItem[]
  ownedProperties Property[] @relation("PropertyOwner")
  realEstateProfile ContactRealEstateProfile?
  searchCriteria SearchCriteria[]
  deals Deal[] @relation("DealClient")
  viewings Viewing[] @relation("ViewingContact")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Entreprise {
  id          String   @id @default(cuid())
  nom         String   @unique
  email       String?
  telephone   String?
  siteWeb     String?
  secteur     String?
  adresse     String?
  ville       String?
  departement String?
  pays        String?
  contacts    EntrepriseContact[]
  activities  Activity[]
  actionItems ActionItem[]
  projects    Project[]
  properties  Property[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EntrepriseContact {
  entrepriseId String
  contactId    String
  poste        String?
  service      String?
  dateDebut    DateTime? @db.Date
  dateFin      DateTime? @db.Date
  type         String    @default("work")
  createdAt    DateTime @default(now())
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  contact      Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([entrepriseId, contactId])
  @@index([contactId])
}

model LookupOption {
  id        String   @id @default(cuid())
  category  String
  label     String
  value     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, value])
  @@index([category, active, sortOrder])
}

model Project {
  id          String   @id @default(cuid())
  entrepriseId String?
  nom         String
  pays        String?
  ville       String?
  statut      String   @default("En cours")
  budget      String?
  progression Int      @default(0)
  entreprise  Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: SetNull)
  contacts ContactProject[]
  property Property?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entrepriseId])
}

model ContactProject {
  contactId String
  projectId String
  interesse Boolean  @default(true)
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([contactId, projectId])
  @@index([projectId])
}

model ContactNickname {
  id        String   @id @default(cuid())
  contactId String
  value     String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, value])
}

model ContactEmail {
  id        String   @id @default(cuid())
  contactId String
  address   String
  type      String   @default("other")
  label     String?
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model ContactPhone {
  id        String   @id @default(cuid())
  contactId String
  number    String
  type      String   @default("mobile")
  label     String?
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model ContactAddress {
  id               String   @id @default(cuid())
  contactId        String
  street           String?
  extendedAddress  String?
  poBox            String?
  locality         String?
  region           String?
  postalCode       String?
  country          String?
  type             String   @default("home")
  label            String?
  contact          Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model ContactEvent {
  id        String   @id @default(cuid())
  contactId String
  label     String
  date      DateTime @db.Date
  type      String   @default("other")
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, date])
}

model ContactRelation {
  id               String   @id @default(cuid())
  contactId        String
  relatedContactId String?
  relatedName      String?
  type             String
  contact          Contact  @relation("ContactRelationsOwner", fields: [contactId], references: [id], onDelete: Cascade)
  relatedContact   Contact? @relation("ContactRelationsTarget", fields: [relatedContactId], references: [id], onDelete: SetNull)

  @@index([contactId])
  @@index([relatedContactId])
}

model ContactUrl {
  id        String   @id @default(cuid())
  contactId String
  url       String
  type      String   @default("other")
  label     String?
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model ContactImClient {
  id        String   @id @default(cuid())
  contactId String
  username String
  protocol String?
  type      String   @default("other")
  label     String?
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model ContactGroup {
  id        String   @id @default(cuid())
  nom       String   @unique
  membres   ContactGroupMembership[]
  createdAt DateTime @default(now())
}

model ContactGroupMembership {
  contactId String
  groupId   String
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([contactId, groupId])
  @@index([groupId])
}

model ContactUserDefined {
  id        String   @id @default(cuid())
  contactId String
  key       String
  value     String   @db.Text
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, key])
}

model ContactInterest {
  id        String   @id @default(cuid())
  contactId String
  value     String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, value])
}

model ContactSkill {
  id        String   @id @default(cuid())
  contactId String
  value     String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, value])
}

model ContactNote {
  id             String            @id @default(cuid())
  contactId      String
  date           DateTime          @default(now()) @db.Date
  nature         ContactNoteNature
  contenu        String            @db.Text
  authorId       String?
  authorUsername String
  searchVector   Unsupported("tsvector")?
  contact        Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author         User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([contactId, date])
  @@index([authorId, createdAt])
}

model Activity {
  id             String    @id @default(cuid())
  titre          String
  type           String
  canal          String?
  dureeMinutes   Int?
  resultat       String?   @db.Text
  prochaineAction String?  @db.Text
  statut         String?
  dateRealisation DateTime? @db.Date
  contactLabel   String?   @map("contact")
  contactId      String?
  entrepriseId   String?
  responsableId  String?
  date           DateTime?
  details        String?
  contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  entreprise     Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: SetNull)
  responsable    User?     @relation("ActivityResponsible", fields: [responsableId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([contactId])
  @@index([entrepriseId])
  @@index([responsableId])
  @@index([statut, dateRealisation])
}

model ActionItem {
  id             String    @id @default(cuid())
  titre          String
  priorite       String    @default("Normale")
  statut         String    @default("À faire")
  canal          String?
  dureeMinutes   Int?
  resultat       String?   @db.Text
  prochaineAction String?  @db.Text
  dateRealisation DateTime? @db.Date
  contactLabel   String?   @map("contact")
  contactId      String?
  entrepriseId   String?
  responsableId  String?
  dateEcheance   DateTime?
  details        String?
  contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  entreprise     Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: SetNull)
  responsable    User?     @relation("ActionResponsible", fields: [responsableId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([contactId])
  @@index([entrepriseId])
  @@index([responsableId])
  @@index([statut, dateRealisation])
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  prenom          String?
  passwordHash    String
  twoFactorSecret String
  role            String    @default("member")
  active          Boolean   @default(true)
  authoredContactNotes ContactNote[]
  activitiesAssigned Activity[] @relation("ActivityResponsible")
  actionsAssigned    ActionItem[] @relation("ActionResponsible")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actorUsername String
  action        String
  entity        String
  entityId      String?
  details       String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

model Agent {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  createdAt DateTime @default(now())

  mandates Mandate[]
  deals    Deal[]
  viewings Viewing[]
}

model ContactRealEstateProfile {
  id              String           @id @default(cuid())
  contactId       String           @unique
  contact         Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  nationality     String?
  residencyStatus ResidencyStatus?
  visaType        String?
  visaExpiryDate  DateTime?
  financingType   FinancingType?
  leadSource      String?
  notes           String?
}

model SearchCriteria {
  id              String          @id @default(cuid())
  contactId       String
  contact         Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  transactionType TransactionType
  propertyTypes   PropertyType[]
  areas           String[]
  budgetMin       Decimal?        @db.Decimal(20, 2)
  budgetMax       Decimal?        @db.Decimal(20, 2)
  currency        String          @default("IDR")
  minBedrooms     Int?
  minLandAreaSqm  Decimal?        @db.Decimal(12, 2)
  mustHave        String[]
  niceToHave      String[]
  targetDate      DateTime?
  isActive        Boolean         @default(true)
  notes           String?
  createdAt       DateTime        @default(now())

  @@index([contactId])
}

model Property {
  id            String           @id @default(cuid())
  reference     String           @unique
  title         String
  country       String?
  projectStatus String?
  projectBudget String?
  projectBudgetAmount Decimal? @db.Decimal(20, 2)
  projectBudgetCurrency String? @db.VarChar(3)
  projectBudgetEur Decimal? @db.Decimal(20, 2)
  projectBudgetUsd Decimal? @db.Decimal(20, 2)
  projectBudgetIdr Decimal? @db.Decimal(20, 2)
  projectBudgetRateEurUsd Decimal? @db.Decimal(18, 8)
  projectBudgetRateEurIdr Decimal? @db.Decimal(18, 8)
  projectBudgetRateUsdIdr Decimal? @db.Decimal(18, 8)
  projectBudgetRateDate DateTime? @db.Date
  projectProgression  Int?
  entrepriseId         String?
  legacyProjectId String?        @unique
  description   String?
  type          PropertyType
  status        PropertyStatus   @default(AVAILABLE)
  condition     PropertyCondition?
  yearBuilt     Int?
  yearRenovated Int?

  ownerId String?
  owner   Contact? @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  entreprise Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: SetNull)
  legacyProject Project? @relation(fields: [legacyProjectId], references: [id], onDelete: SetNull)

  address              String?
  kecamatan            String?
  kabupaten            String?
  province             String?
  postalCode           String?
  neighborhood         String?
  latitude             Decimal? @db.Decimal(9, 6)
  longitude            Decimal? @db.Decimal(9, 6)
  distanceBeachKm      Decimal? @db.Decimal(6, 2)
  distanceAirportKm    Decimal? @db.Decimal(6, 2)
  accessRoadWidthM     Decimal? @db.Decimal(5, 2)
  accessRoadType       String?
  views                String[]
  floodRisk            Boolean?

  landAreaSqm          Decimal? @db.Decimal(12, 2)
  buildingAreaSqm      Decimal? @db.Decimal(12, 2)
  bedrooms             Int?
  bathrooms            Int?
  floors               Int?
  hasPool              Boolean  @default(false)
  hasGarden            Boolean  @default(false)
  parkingSpaces        Int?
  furnishing           Furnishing?
  amenities            String[]

  electricityVA        Int?
  waterSource          WaterSource?
  sanitation           String?
  internetProvider     String?
  staffIncluded        String[]

  managementCompany    String?
  estimatedYieldPct    Decimal? @db.Decimal(5, 2)
  occupancyRatePct     Decimal? @db.Decimal(5, 2)

  zoning               ZoningType?
  buildingPermit       BuildingPermitStatus?
  hasLitigation        Boolean  @default(false)
  hasMortgageLien      Boolean  @default(false)
  banjarFeesMonthly    Decimal? @db.Decimal(14, 2)
  foreignerEligible    Boolean?
  foreignerEligibleNote String?

  landTitle LandTitle?
  mandates  Mandate[]
  deals     Deal[]
  viewings  Viewing[]
  documents PropertyDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([province, kabupaten])
  @@index([entrepriseId])
}

model LandTitle {
  id         String   @id @default(cuid())
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  rightType         LandRightType
  certificateNumber String?
  nib               String?
  holderName        String?
  holdingStructure  HoldingStructure?
  verifiedWithBpn   Boolean   @default(false)
  verifiedAt        DateTime?

  expiryDate        DateTime?
  remainingYears    Decimal?  @db.Decimal(5, 1)
  extensionPossible Boolean?
  extensionCost     Decimal?  @db.Decimal(20, 2)

  leaseStartDate DateTime?
  leaseEndDate   DateTime?
  renewalOption  Boolean?
  lessorName     String?

  notes String?
}

model Mandate {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agentId    String?
  agent      Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  transactionType  TransactionType
  mandateType      MandateType
  startDate        DateTime?
  endDate          DateTime?
  isActive         Boolean         @default(true)
  commissionPct    Decimal?        @db.Decimal(5, 2)
  commissionPaidBy PayerParty?

  askingPrice      Decimal?  @db.Decimal(20, 2)
  currency         String    @default("IDR")
  priceUnit        PriceUnit @default(TOTAL)
  exchangeRate     Decimal?  @db.Decimal(18, 6)
  exchangeRateDate DateTime?

  monthlyRent       Decimal? @db.Decimal(20, 2)
  annualRent        Decimal? @db.Decimal(20, 2)
  minDurationMonths Int?
  securityDeposit   Decimal? @db.Decimal(20, 2)
  chargesIncluded   Boolean?

  publishedOnPortals String[]
  notes              String?

  deals Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

model Deal {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mandateId  String?
  mandate    Mandate? @relation(fields: [mandateId], references: [id], onDelete: SetNull)
  clientId   String
  client     Contact  @relation("DealClient", fields: [clientId], references: [id], onDelete: Restrict)
  agentId    String?
  agent      Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  transactionType     TransactionType
  stage               DealStage  @default(PROSPECT)
  negotiatedPrice     Decimal?   @db.Decimal(20, 2)
  finalPrice          Decimal?   @db.Decimal(20, 2)
  currency            String     @default("IDR")
  expectedClosingDate DateTime?
  closedAt            DateTime?
  lostReason          String?
  notes               String?

  offers    Offer[]
  costs     TransactionCost[]
  documents PropertyDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([clientId])
}

model Offer {
  id          String      @id @default(cuid())
  dealId      String
  deal        Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  amount      Decimal     @db.Decimal(20, 2)
  currency    String      @default("IDR")
  conditions  String?
  status      OfferStatus @default(PENDING)
  offeredAt   DateTime    @default(now())
  respondedAt DateTime?
}

model Viewing {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact  @relation("ViewingContact", fields: [contactId], references: [id], onDelete: Cascade)
  agentId       String?
  agent         Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  scheduledAt   DateTime
  feedback      String?
  interestLevel Int?
  createdAt     DateTime @default(now())

  @@index([propertyId])
  @@index([contactId])
}

model TransactionCost {
  id       String    @id @default(cuid())
  dealId   String
  deal     Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type     CostType
  amount   Decimal?  @db.Decimal(20, 2)
  currency String    @default("IDR")
  paidBy   PayerParty @default(TO_BE_DETERMINED)
  notes    String?
}

model PropertyDocument {
  id         String        @id @default(cuid())
  type       DocumentType
  name       String
  url        String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  propertyId String?
  property   Property?     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
}
