// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id         String   @id @default(cuid())
  nom        String
  email      String?  @unique
  telephone  String?
  entreprise String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  nom         String
  pays        String?
  ville       String?
  statut      String   @default("En cours")
  budget      String?
  progression Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Activity {
  id        String    @id @default(cuid())
  titre     String
  type      String
  contact   String?
  date      DateTime?
  details   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ActionItem {
  id            String    @id @default(cuid())
  titre         String
  priorite      String    @default("Normale")
  statut        String    @default("À faire")
  contact       String?
  dateEcheance  DateTime?
  details       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  passwordHash    String
  twoFactorSecret String
  role            String    @default("member")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
