{
  "name": "crm-eliccir",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public",
    "start": "prisma migrate deploy && if [ \"$SEED_CONTACTS\" = \"true\" ]; then npm run import:contacts -- --apply contacts_fictifs.csv; fi && HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint",
    "import:contacts": "tsx scripts/import-contacts.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.3",
    "jose": "^6.2.12",
    "next": "16.3.6",
    "otplib": "^13.5.0",
    "prisma": "7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
