// =====================================================================
// MODÈLE IMMOBILIER (vente / location / achat) - marché indonésien inclus
// Brouillon à FUSIONNER dans prisma/schema.prisma (ne pas le remplacer).
//
// Points d'adaptation pour Claude Code :
//  1. Le modèle Contact existe déjà : ne pas le recréer. Ajouter seulement
//     les champs de relation listés en bas de ce fichier.
//  2. Adapter le type des champs "contactId" (String ou Int) à celui de
//     l'id du modèle Contact existant.
//  3. Les montants sont en Decimal (l'IDR atteint de très grands nombres).
// =====================================================================

// ------------------------------- ENUMS -------------------------------

enum PropertyType {
  VILLA
  HOUSE
  APARTMENT
  LAND
  COMMERCIAL
  BUILDING
  WAREHOUSE
  GUESTHOUSE_HOTEL
}

enum PropertyStatus {
  AVAILABLE
  UNDER_OFFER
  SOLD
  RENTED
  WITHDRAWN
}

enum PropertyCondition {
  NEW
  GOOD
  TO_RENOVATE
  OFF_PLAN
}

enum Furnishing {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum WaterSource {
  PDAM
  WELL
  BOTH
  NONE
}

enum TransactionType {
  SALE
  SHORT_TERM_RENTAL
  LONG_TERM_RENTAL
  PURCHASE_SEARCH
}

enum MandateType {
  EXCLUSIVE
  SIMPLE
  CO_AGENCY
}

enum PriceUnit {
  TOTAL
  PER_SQM
  PER_ARE
  PER_MONTH
  PER_YEAR
}

enum PayerParty {
  BUYER
  SELLER
  SPLIT
  TO_BE_DETERMINED
}

enum DealStage {
  PROSPECT
  MANDATE_SIGNED
  LISTED
  OFFER_RECEIVED
  PRELIMINARY_AGREEMENT
  CLOSED
  LOST
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
}

enum FinancingType {
  CASH
  MORTGAGE
  MIXED
}

// --- Spécificités Indonésie ---

enum LandRightType {
  HAK_MILIK // SHM : pleine propriété, non accessible aux étrangers en direct
  HGB // Hak Guna Bangunan : droit de construire
  HAK_PAKAI // Droit d'usage (30 + 20 + 30 ans)
  HAK_SEWA // Bail contractuel, sans certificat BPN
  HMSRS // Propriété d'un lot d'appartement (strata title)
  GIRIK // Titre non certifié (Girik / Letter C) : risque élevé
  UNKNOWN
}

enum HoldingStructure {
  INDIVIDUAL
  LOCAL_COMPANY // PT local
  PT_PMA // Société à capitaux étrangers
}

enum BuildingPermitStatus {
  PBG_OBTAINED // Persetujuan Bangunan Gedung (remplace l'IMB)
  SLF_OBTAINED // Sertifikat Laik Fungsi (conformité d'usage)
  LEGACY_IMB
  NONE
  UNKNOWN
}

enum ZoningType {
  RESIDENTIAL
  TOURISM
  COMMERCIAL
  MIXED
  AGRICULTURAL_PROTECTED // souvent inconstructible
  UNKNOWN
}

enum CostType {
  PBB // taxe foncière annuelle
  BPHTB // taxe d'acquisition (acheteur)
  SELLER_TAX // impôt final côté vendeur
  PPN // TVA sur construction neuve
  NOTARY_PPAT_FEE
  AGENCY_COMMISSION
  OTHER
}

enum ResidencyStatus {
  CITIZEN
  KITAS
  KITAP
  TOURIST
  OTHER
}

enum DocumentType {
  LAND_CERTIFICATE
  PBG
  SLF
  PBB_RECEIPT
  MANDATE
  PPJB // promesse de vente
  AJB // acte de vente définitif devant le PPAT
  LEASE_AGREEMENT
  OTHER
}

// ------------------------------ MODELS -------------------------------

model Agent {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  createdAt DateTime @default(now())

  mandates Mandate[]
  deals    Deal[]
  viewings Viewing[]
}

// Informations immobilières complémentaires d'un contact (acheteur, locataire, vendeur)
model ContactRealEstateProfile {
  id              String           @id @default(cuid())
  contactId       String           @unique
  contact         Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  nationality     String?
  residencyStatus ResidencyStatus?
  visaType        String?
  visaExpiryDate  DateTime?
  financingType   FinancingType?
  leadSource      String?
  notes           String?
}

// Critères de recherche d'un acheteur ou locataire (un contact peut en avoir plusieurs)
model SearchCriteria {
  id              String          @id @default(cuid())
  contactId       String
  contact         Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  transactionType TransactionType
  propertyTypes   PropertyType[]
  areas           String[] // zones souhaitées (Canggu, Ubud...)
  budgetMin       Decimal?        @db.Decimal(20, 2)
  budgetMax       Decimal?        @db.Decimal(20, 2)
  currency        String          @default("IDR")
  minBedrooms     Int?
  minLandAreaSqm  Decimal?        @db.Decimal(12, 2)
  mustHave        String[]
  niceToHave      String[]
  targetDate      DateTime?
  isActive        Boolean         @default(true)
  notes           String?
  createdAt       DateTime        @default(now())

  @@index([contactId])
}

model Property {
  id          String            @id @default(cuid())
  reference   String            @unique
  title       String
  description String?
  type        PropertyType
  status      PropertyStatus    @default(AVAILABLE)
  condition   PropertyCondition?
  yearBuilt   Int?
  yearRenovated Int?

  ownerId String?
  owner   Contact? @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Localisation
  address        String?
  kecamatan      String? // district
  kabupaten      String? // regency / ville
  province       String?
  postalCode     String?
  neighborhood   String? // Canggu, Ubud, Seminyak...
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  distanceBeachKm   Decimal? @db.Decimal(6, 2)
  distanceAirportKm Decimal? @db.Decimal(6, 2)
  accessRoadWidthM  Decimal? @db.Decimal(5, 2)
  accessRoadType    String?
  views             String[] // mer, rizières, jungle, volcan...
  floodRisk         Boolean?

  // Caractéristiques physiques
  landAreaSqm     Decimal? @db.Decimal(12, 2)
  buildingAreaSqm Decimal? @db.Decimal(12, 2)
  bedrooms        Int?
  bathrooms       Int?
  floors          Int?
  hasPool         Boolean  @default(false)
  hasGarden       Boolean  @default(false)
  parkingSpaces   Int?
  furnishing      Furnishing?
  amenities       String[] // climatisation, sécurité, générateur...

  // Réseaux et services
  electricityVA   Int? // puissance PLN en VA
  waterSource     WaterSource?
  sanitation      String? // fosse septique, réseau
  internetProvider String?
  staffIncluded   String[] // gardien, jardinier, ménage

  // Investissement / gestion locative
  managementCompany String?
  estimatedYieldPct Decimal? @db.Decimal(5, 2)
  occupancyRatePct  Decimal? @db.Decimal(5, 2)

  // Indonésie : cadre administratif
  zoning              ZoningType?
  buildingPermit      BuildingPermitStatus?
  hasLitigation       Boolean  @default(false)
  hasMortgageLien     Boolean  @default(false) // hak tanggungan
  banjarFeesMonthly   Decimal? @db.Decimal(14, 2)
  foreignerEligible   Boolean? // à calculer selon titre, prix, province
  foreignerEligibleNote String?

  landTitle LandTitle?
  mandates  Mandate[]
  deals     Deal[]
  viewings  Viewing[]
  documents PropertyDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([province, kabupaten])
}

// Titre foncier et, le cas échéant, bail (Hak Sewa)
model LandTitle {
  id         String   @id @default(cuid())
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  rightType          LandRightType
  certificateNumber  String?
  nib                String? // Nomor Induk Bidang
  holderName         String?
  holdingStructure   HoldingStructure?
  verifiedWithBpn    Boolean   @default(false)
  verifiedAt         DateTime?

  expiryDate         DateTime? // fin du droit (HGB, Hak Pakai) ou du bail
  remainingYears     Decimal?  @db.Decimal(5, 1)
  extensionPossible  Boolean?
  extensionCost      Decimal?  @db.Decimal(20, 2)

  // Spécifique bail (Hak Sewa)
  leaseStartDate     DateTime?
  leaseEndDate       DateTime?
  renewalOption      Boolean?
  lessorName         String?

  notes String?
}

// Mandat de vente ou de location confié à l'agence
model Mandate {
  id         String          @id @default(cuid())
  propertyId String
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agentId    String?
  agent      Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)

  transactionType TransactionType
  mandateType     MandateType
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean         @default(true)

  commissionPct   Decimal?   @db.Decimal(5, 2)
  commissionPaidBy PayerParty?

  // Prix
  askingPrice     Decimal?   @db.Decimal(20, 2)
  currency        String     @default("IDR")
  priceUnit       PriceUnit  @default(TOTAL)
  exchangeRate    Decimal?   @db.Decimal(18, 6) // vers USD ou EUR affiché
  exchangeRateDate DateTime?

  // Location
  monthlyRent       Decimal? @db.Decimal(20, 2)
  annualRent        Decimal? @db.Decimal(20, 2)
  minDurationMonths Int?
  securityDeposit   Decimal? @db.Decimal(20, 2)
  chargesIncluded   Boolean?

  // Diffusion
  publishedOnPortals String[]
  notes              String?

  deals Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

// Dossier de transaction : lie un bien à un acheteur / locataire
model Deal {
  id         String          @id @default(cuid())
  propertyId String
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mandateId  String?
  mandate    Mandate?        @relation(fields: [mandateId], references: [id], onDelete: SetNull)
  clientId   String
  client     Contact         @relation("DealClient", fields: [clientId], references: [id], onDelete: Restrict)
  agentId    String?
  agent      Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)

  transactionType     TransactionType
  stage               DealStage       @default(PROSPECT)
  negotiatedPrice     Decimal?        @db.Decimal(20, 2)
  finalPrice          Decimal?        @db.Decimal(20, 2)
  currency            String          @default("IDR")
  expectedClosingDate DateTime?
  closedAt            DateTime?
  lostReason          String?
  notes               String?

  offers    Offer[]
  costs     TransactionCost[]
  documents PropertyDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([clientId])
}

model Offer {
  id         String      @id @default(cuid())
  dealId     String
  deal       Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  amount     Decimal     @db.Decimal(20, 2)
  currency   String      @default("IDR")
  conditions String?
  status     OfferStatus @default(PENDING)
  offeredAt  DateTime    @default(now())
  respondedAt DateTime?
}

model Viewing {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact   @relation("ViewingContact", fields: [contactId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  scheduledAt DateTime
  feedback    String?
  interestLevel Int? // 1 à 5
  createdAt   DateTime  @default(now())

  @@index([propertyId])
  @@index([contactId])
}

// Taxes et frais d'une transaction (qui paie quoi)
model TransactionCost {
  id       String     @id @default(cuid())
  dealId   String
  deal     Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type     CostType
  amount   Decimal?   @db.Decimal(20, 2)
  currency String     @default("IDR")
  paidBy   PayerParty @default(TO_BE_DETERMINED)
  notes    String?
}

model PropertyDocument {
  id         String       @id @default(cuid())
  type       DocumentType
  name       String
  url        String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  propertyId String?
  property   Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
}

